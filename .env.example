# -----------------------------------------------------------------------------
# ResumeIQ - Environment Variables Example Template
# Copy this file to '.env' and fill in your actual credentials.
# -----------------------------------------------------------------------------

# Next.js Server Configuration
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database (e.g. Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/resumeiq?schema=public"

# NextAuth.js Config (v5)
# Generate a secret: 'npx auth secret' or 'openssl rand -base64 33'
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_key_here"

# NextAuth OAuth Providers (Register apps in Google Cloud & GitHub Developer Settings)
AUTH_GOOGLE_ID="your_google_oauth_client_id"
AUTH_GOOGLE_SECRET="your_google_oauth_client_secret"
AUTH_GITHUB_ID="your_github_oauth_client_id"
AUTH_GITHUB_SECRET="your_github_oauth_client_secret"

# Anthropic Claude API (Used for resume analysis & cover letters)
# Key format: 'sk-ant-api03-...'
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Stripe Payments & Subscriptions (Upgrade to Pro Plan)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"
STRIPE_PRICE_ID="price_your_stripe_recurring_price_id"

# Uploadthing File Storage (For PDF/DOCX resume file uploads)
UPLOADTHING_SECRET="sk_live_your_uploadthing_secret"
UPLOADTHING_APP_ID="your_uploadthing_app_id"

# Resend Transactional Email (For weekly digest / follow-up email notifications)
RESEND_API_KEY="re_your_resend_api_key"
